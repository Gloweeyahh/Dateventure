# These are the settings the API reads. On Render you type them into the "Environment" tab.
# (You do NOT create a file called .env on Render. This list is just a reference.)

# Where invitations are saved. Get this free from MongoDB Atlas. Without it, invitations vanish when the server sleeps.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=dateventure

# A long random text. Render can generate it. If it ever changes, venue links made before the change stop working.
SIGNING_SECRET=change-me-to-a-long-random-text

# Your website address(es), comma separated, no slash at the end. Needed so the browser is allowed to call the API.
ALLOWED_ORIGINS=https://your-site.netlify.app

# Your email. OpenStreetMap's free services require an identifiable contact.
CONTACT_EMAIL=you@example.com

# OPTIONAL: real Google photos on result cards, venue pages and invitations. Leave empty to skip.
# Setup steps are in docs/DEPLOY.md, Part 8. Google needs a billing card on file but only charges past its free monthly allowance.
GOOGLE_PLACES_API_KEY=
# Safety brakes. The app stops calling Google BEFORE these numbers, so a busy day cannot cost you.
# (Google's free allowance, checked Sept 2026: 5,000 place searches and 1,000 photo downloads a month.)
GOOGLE_SEARCH_MONTHLY_CAP=4500
GOOGLE_PHOTO_MONTHLY_CAP=900
# Small photos on result cards use the photo allowance fastest. true/false:
GOOGLE_CARD_PHOTOS=true
# Cards may use at most this share of the photo allowance, keeping the rest for venue pages and invitations:
GOOGLE_CARD_PHOTO_SHARE=0.5

# Render sits behind a proxy, so leave this as true there.
TRUST_PROXY=true
LOG_LEVEL=info
